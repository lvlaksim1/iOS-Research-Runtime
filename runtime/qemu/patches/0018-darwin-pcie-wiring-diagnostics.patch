From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iOS Research Runtime <noreply@example.invalid>
Date: Tue, 6 Oct 2026 01:36:00 +0000
Subject: [PATCH] darwin: report synthetic PCIe window wiring

Emit one machine-level diagnostic after the GPEX ECAM and MMIO aliases are
installed. This proves the synthetic host wiring exists in the exact runtime
before attributing zero ECAM traffic solely to guest provider matching.
---
 hw/arm/darwin.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/hw/arm/darwin.c b/hw/arm/darwin.c
--- a/hw/arm/darwin.c
+++ b/hw/arm/darwin.c
@@ -249,6 +249,10 @@ static void darwin_init(MachineState *ms) {
     memory_region_init_alias(pcie_mmio, OBJECT(pcie), "darwin-pcie-mmio",
                              mmio_region, pcie_mmio_base, pcie_mmio_size);
     memory_region_add_subregion(get_system_memory(), pcie_mmio_base, pcie_mmio);
+    fprintf(stderr,
+            "[ios-m3-pcie-wiring] ecam=0x%" HWADDR_PRIx
+            " mmio=0x%" HWADDR_PRIx " host=gpex-pcihost\n",
+            pcie_ecam_base, pcie_mmio_base);
 
     info->has_mte = kc_uses_mte(info->bootkc_f.buf);
