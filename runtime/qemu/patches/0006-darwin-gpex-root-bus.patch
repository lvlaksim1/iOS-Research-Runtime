From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iOS Research Runtime <noreply@example.invalid>
Date: Thu, 1 Oct 2026 17:35:00 +0000
Subject: [PATCH] darwin: expose GPEX ECAM and MMIO windows

The GPEX root bus now realizes and lets QEMU instantiate the NVMe device, but
the guest has no /dev/disk nodes. Map bounded ECAM and PCI MMIO aliases into
the Darwin physical address space as the next prerequisite for guest PCI
enumeration. DeviceTree discovery remains a separate evidence-driven step.
---
 hw/arm/darwin.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/hw/arm/darwin.c b/hw/arm/darwin.c
--- a/hw/arm/darwin.c
+++ b/hw/arm/darwin.c
@@ -224,10 +224,31 @@ static void darwin_init(MachineState *ms) {
     dt_root = info->dtree_f.buf;
 
     check_dtree(dt_root);
 
     DeviceState *pcie = qdev_new("gpex-pcihost");
     object_property_set_int(OBJECT(pcie), "num-irqs", 0, &error_fatal);
     sysbus_realize_and_unref(SYS_BUS_DEVICE(pcie), &error_fatal);
+
+    /*
+     * Bounded storage bring-up window.  Keep these low and outside Apple
+     * arm-io/DRAM; a later DeviceTree mutation will advertise them to XNU.
+     */
+    const hwaddr pcie_mmio_base = 0x10000000;
+    const hwaddr pcie_mmio_size = 0x10000000;
+    const hwaddr pcie_ecam_base = 0x3f000000;
+    const hwaddr pcie_ecam_size = 0x01000000;
+    MemoryRegion *pcie_ecam = g_new0(MemoryRegion, 1);
+    MemoryRegion *pcie_mmio = g_new0(MemoryRegion, 1);
+    MemoryRegion *ecam_region =
+        sysbus_mmio_get_region(SYS_BUS_DEVICE(pcie), 0);
+    MemoryRegion *mmio_region =
+        sysbus_mmio_get_region(SYS_BUS_DEVICE(pcie), 1);
+    memory_region_init_alias(pcie_ecam, OBJECT(pcie), "darwin-pcie-ecam",
+                             ecam_region, 0, pcie_ecam_size);
+    memory_region_add_subregion(get_system_memory(), pcie_ecam_base, pcie_ecam);
+    memory_region_init_alias(pcie_mmio, OBJECT(pcie), "darwin-pcie-mmio",
+                             mmio_region, pcie_mmio_base, pcie_mmio_size);
+    memory_region_add_subregion(get_system_memory(), pcie_mmio_base, pcie_mmio);
 
     info->has_mte = kc_uses_mte(info->bootkc_f.buf);
 
