{
  "schema": "engineering-quality-v1",
  "project": "lvlaksim1/iOS-Research-Runtime",
  "quick": [
    {
      "id": "tracked_source_sanity",
      "kind": "static",
      "command": [
        "python",
        "scripts/quality_source_sanity.py"
      ],
      "timeout_sec": 65
    }
  ],
  "full_additional": [
    {
      "id": "architecture_project_dependencies",
      "kind": "static",
      "command": [
        "python",
        "scripts/architecture_explorer.py",
        "--check"
      ],
      "timeout_sec": 60
    },
    {
      "id": "ios_tar_preflight",
      "kind": "sandbox",
      "command": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/python",
        "-p",
        "test_check_m3_ioprint_tar_mode.py"
      ],
      "timeout_sec": 85
    },
    {
      "id": "roslyn_syntax_architecture",
      "kind": "static",
      "command": [
        "dotnet",
        "run",
        "--project",
        "quality/roslyn/ArchitectureRoslyn.csproj",
        "-c",
        "Release",
        "--",
        "."
      ],
      "timeout_sec": 220
    },
    {
      "id": "roslyn_regression_gate",
      "kind": "static",
      "command": [
        "python",
        "quality/roslyn/compare_roslyn_quality.py",
        "--check"
      ],
      "timeout_sec": 40
    }
  ]
}
